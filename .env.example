# Razorpay (server secrets — never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Optional: RAZORPAY_WEBHOOK_SECRET=

# Single base event price (change here → all currencies update via FX)
EVENT_PRICE=999
EVENT_CURRENCY=INR
# Public mirrors for display / static-export client fallback (backend remains source of truth when APIs run)
NEXT_PUBLIC_EVENT_PRICE=999
NEXT_PUBLIC_EVENT_CURRENCY=INR

# Optional fixed FX overrides: <CURRENCY>:<rate per 1 EVENT_CURRENCY unit>
# If omitted, live ECB rates are fetched from frankfurter.app and cached for 1 hour.
# EVENT_FX_RATES=USD:0.012,GBP:0.0095,EUR:0.011,AUD:0.018,CAD:0.0165
# NEXT_PUBLIC_EVENT_FX_RATES=USD:0.012,GBP:0.0095,EUR:0.011,AUD:0.018,CAD:0.0165

# Used when country/currency cannot be resolved or Razorpay rejects a currency
EVENT_FALLBACK_CURRENCY=USD
EVENT_FALLBACK_COUNTRY=IN
NEXT_PUBLIC_EVENT_FALLBACK_COUNTRY=IN

# Careers Apply modal — paste google-apps-script-careers.js into the sheet Apps Script, then redeploy.
NEXT_PUBLIC_CAREERS_APPS_SCRIPT_URL=
